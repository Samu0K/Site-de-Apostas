# Porta do servidor
PORT=3333

# Origem permitida para CORS (URL do frontend)
FRONTEND_ORIGIN=http://localhost:5500

# Valor minimo esperado no comprovante (em reais, ex: 47.90)
EXPECTED_MIN_AMOUNT=47.90

# Confianca minima do OCR para considerar o comprovante valido (0 a 1)
MIN_OCR_CONFIDENCE=0.55

# Link do grupo de WhatsApp liberado apos validacao
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/SEU_LINK_AQUI

# Tamanho maximo de upload em bytes (5MB)
MAX_UPLOAD_SIZE=5242880
